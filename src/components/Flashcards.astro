---
import { DECKS } from '../data/civics-cards';
---

<div class="flashcards" data-flashcards>
	<div class="deck-tabs" role="tablist" aria-label="Choose a deck">
		{
			DECKS.map((deck, i) => (
				<button
					type="button"
					class:list={['deck-tab', i === 0 && 'active']}
					role="tab"
					aria-selected={i === 0 ? 'true' : 'false'}
					aria-controls="fc-stage"
					data-deck-tab={deck.id}
				>
					<span class="deck-tab-label">{deck.label}</span>
					<span class="deck-tab-count">{deck.cards.length} cards</span>
				</button>
			))
		}
	</div>

	<p class="deck-blurb" data-blurb>{DECKS[0].blurb}</p>

	<div class="fc-stage" id="fc-stage" role="tabpanel">
		<p class="fc-progress" aria-live="polite" data-progress></p>

		<div class="fc-play" data-play>
			<button type="button" class="fc-card" data-card aria-pressed="false">
				<span class="fc-face fc-face--front">
					<span class="fc-face-label">Prompt</span>
					<span class="fc-front-text" data-front></span>
					<span class="fc-flip-hint" aria-hidden="true">✦ Tap to flip ✦</span>
				</span>
				<span class="fc-face fc-face--back">
					<span class="fc-face-label fc-face-label--gold">Answer</span>
					<span class="fc-back-text" data-back></span>
					<span class="fc-hook" data-hook hidden></span>
				</span>
			</button>

			<div class="fc-judge" data-judge hidden>
				<p class="fc-judge-prompt">Did you have it?</p>
				<div class="fc-judge-buttons">
					<button type="button" class="btn fc-btn-know" data-know>Knew it</button>
					<button type="button" class="btn btn-outline fc-btn-review" data-review>
						Still learning
					</button>
				</div>
				<p class="fc-judge-note">"Still learning" sends the card to the back of the deck.</p>
			</div>

			<div class="fc-controls">
				<button type="button" class="fc-shuffle" data-shuffle>↻ Restart &amp; shuffle</button>
			</div>
		</div>

		<div class="fc-summary cp-frame" data-summary hidden>
			<span class="cp-seal fc-summary-seal" aria-hidden="true">★</span>
			<p class="fc-summary-kicker">Certificate of Completion</p>
			<p class="fc-summary-headline" data-summary-headline></p>
			<p class="fc-summary-detail" data-summary-detail></p>
			<div class="fc-summary-buttons">
				<button type="button" class="btn" data-again>Play again</button>
				<button type="button" class="btn btn-outline" data-missed hidden>
					Replay the ones I missed
				</button>
			</div>
		</div>
	</div>

	<noscript>
		<p class="fc-noscript">
			The flashcard game needs JavaScript. No worries — every term also appears in plain text on
			the <a href="/learn/">Start Here guide</a>.
		</p>
	</noscript>

	<script type="application/json" data-fc-data set:html={JSON.stringify(DECKS)} />
</div>

<script>
	interface Flashcard {
		front: string;
		back: string;
		hook?: string;
	}
	interface Deck {
		id: string;
		label: string;
		blurb: string;
		cards: Flashcard[];
	}

	const root = document.querySelector<HTMLElement>('[data-flashcards]');

	if (root) {
		const decks: Deck[] = JSON.parse(
			root.querySelector('[data-fc-data]')?.textContent ?? '[]',
		);

		const blurbEl = root.querySelector<HTMLElement>('[data-blurb]')!;
		const progressEl = root.querySelector<HTMLElement>('[data-progress]')!;
		const playEl = root.querySelector<HTMLElement>('[data-play]')!;
		const cardEl = root.querySelector<HTMLButtonElement>('[data-card]')!;
		const frontEl = root.querySelector<HTMLElement>('[data-front]')!;
		const backEl = root.querySelector<HTMLElement>('[data-back]')!;
		const hookEl = root.querySelector<HTMLElement>('[data-hook]')!;
		const judgeEl = root.querySelector<HTMLElement>('[data-judge]')!;
		const summaryEl = root.querySelector<HTMLElement>('[data-summary]')!;
		const summaryHeadline = root.querySelector<HTMLElement>('[data-summary-headline]')!;
		const summaryDetail = root.querySelector<HTMLElement>('[data-summary-detail]')!;
		const missedBtn = root.querySelector<HTMLButtonElement>('[data-missed]')!;

		let deck: Deck = decks[0];
		let queue: number[] = [];
		let attempted = new Set<number>();
		let missedFirstTry = new Set<number>();
		let done = 0;
		let total = 0;

		function shuffle<T>(arr: T[]): T[] {
			const a = [...arr];
			for (let i = a.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[a[i], a[j]] = [a[j], a[i]];
			}
			return a;
		}

		function setFlipped(flipped: boolean, animate = true) {
			cardEl.classList.toggle('no-anim', !animate);
			cardEl.classList.toggle('flipped', flipped);
			cardEl.setAttribute('aria-pressed', String(flipped));
			judgeEl.hidden = !flipped;
			if (!animate) {
				// Force reflow so the transition class removal applies before re-enabling.
				void cardEl.offsetWidth;
				cardEl.classList.remove('no-anim');
			}
		}

		function renderCard() {
			const card = deck.cards[queue[0]];
			frontEl.textContent = card.front;
			backEl.textContent = card.back;
			hookEl.textContent = card.hook ?? '';
			hookEl.hidden = !card.hook;
			progressEl.textContent = `${done} of ${total} down · ${queue.length} to go`;
			setFlipped(false, false);
		}

		function startDeck(cardIndices?: number[]) {
			queue = shuffle(cardIndices ?? deck.cards.map((_, i) => i));
			attempted = new Set();
			missedFirstTry = new Set();
			done = 0;
			total = queue.length;
			summaryEl.hidden = true;
			playEl.hidden = false;
			renderCard();
		}

		function finishDeck() {
			playEl.hidden = true;
			summaryEl.hidden = false;
			const firstTry = total - missedFirstTry.size;
			progressEl.textContent = 'Deck complete!';
			summaryHeadline.textContent =
				firstTry === total
					? `Perfect — all ${total} on the first try.`
					: `You knew ${firstTry} of ${total} on the first try.`;
			summaryDetail.textContent =
				firstTry === total
					? 'Try another deck, or shuffle this one and see if it sticks.'
					: 'The ones you missed came back around until you had them — that’s the whole trick.';
			missedBtn.hidden = missedFirstTry.size === 0;
		}

		function advance(knewIt: boolean) {
			const idx = queue.shift()!;
			if (!attempted.has(idx)) {
				attempted.add(idx);
				if (!knewIt) missedFirstTry.add(idx);
			}
			if (knewIt) {
				done += 1;
			} else {
				queue.push(idx);
			}
			if (queue.length === 0) {
				finishDeck();
			} else {
				renderCard();
			}
		}

		cardEl.addEventListener('click', () => {
			setFlipped(!cardEl.classList.contains('flipped'));
		});

		root.querySelector('[data-know]')?.addEventListener('click', () => advance(true));
		root.querySelector('[data-review]')?.addEventListener('click', () => advance(false));
		root.querySelector('[data-shuffle]')?.addEventListener('click', () => startDeck());
		root.querySelector('[data-again]')?.addEventListener('click', () => startDeck());
		missedBtn.addEventListener('click', () => startDeck([...missedFirstTry]));

		root.querySelectorAll<HTMLButtonElement>('[data-deck-tab]').forEach((tab) => {
			tab.addEventListener('click', () => {
				const next = decks.find((d) => d.id === tab.dataset.deckTab);
				if (!next) return;
				deck = next;
				blurbEl.textContent = deck.blurb;
				root.querySelectorAll('[data-deck-tab]').forEach((t) => {
					const active = t === tab;
					t.classList.toggle('active', active);
					t.setAttribute('aria-selected', String(active));
				});
				startDeck();
			});
		});

		startDeck();
	}
</script>

<style>
	.flashcards {
		max-width: 44rem;
		margin: 0 auto;
	}

	.deck-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.deck-tab {
		flex: 1 1 10rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		padding: 0.7rem 0.9rem 0.55rem;
		background: var(--cp-cream, #f6f0dd);
		border: 2px solid var(--cp-green, #1e4d38);
		border-top-width: 4px;
		cursor: pointer;
		font-family: var(--font-sans);
		color: var(--cp-green-dark, #143427);
		transition: background 0.15s;
	}

	.deck-tab:hover {
		background: var(--cp-parchment, #eee5cb);
	}

	.deck-tab.active {
		background: var(--cp-green, #1e4d38);
		color: var(--cp-cream, #f6f0dd);
		border-top-color: var(--cp-gold-bright, #c9a227);
	}

	.deck-tab-label {
		font-weight: 700;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.deck-tab-count {
		font-size: 0.75rem;
		opacity: 0.7;
	}

	.deck-blurb {
		font-family: var(--font-sans);
		color: var(--cp-ink, #1c2b23);
		opacity: 0.75;
		font-size: 0.9rem;
		text-align: center;
		margin: 0 0 1.5rem;
	}

	.fc-progress {
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--cp-gold, #a3781e);
		text-align: center;
		margin: 0 0 0.75rem;
		min-height: 1.2em;
	}

	.fc-card {
		display: block;
		width: 100%;
		min-height: 21rem;
		position: relative;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		text-align: left;
		perspective: 1200px;
		font: inherit;
		color: var(--cp-ink, #1c2b23);
	}

	/* Each face is styled like the face of a banknote: cream field with a fine
	   cross-hatch, a double frame, and gold studs in the corners. */
	.fc-face {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.75rem;
		background-color: var(--cp-cream, #f6f0dd);
		background-image: radial-gradient(circle, var(--cp-gold, #a3781e) 0 2.5px, transparent 3px),
			radial-gradient(circle, var(--cp-gold, #a3781e) 0 2.5px, transparent 3px),
			radial-gradient(circle, var(--cp-gold, #a3781e) 0 2.5px, transparent 3px),
			radial-gradient(circle, var(--cp-gold, #a3781e) 0 2.5px, transparent 3px),
			repeating-linear-gradient(45deg, rgba(30, 77, 56, 0.04) 0 1px, transparent 1px 6px),
			repeating-linear-gradient(-45deg, rgba(30, 77, 56, 0.04) 0 1px, transparent 1px 6px);
		background-size: 9px 9px, 9px 9px, 9px 9px, 9px 9px, auto, auto;
		background-repeat: no-repeat, no-repeat, no-repeat, no-repeat, repeat, repeat;
		background-position: left 7px top 7px, right 7px top 7px, left 7px bottom 7px,
			right 7px bottom 7px, 0 0, 0 0;
		border: 2px solid var(--cp-green, #1e4d38);
		outline: 1px solid rgba(30, 77, 56, 0.5);
		outline-offset: -7px;
		box-shadow: 6px 6px 0 rgba(20, 52, 39, 0.18);
		backface-visibility: hidden;
		transition: transform 0.5s;
		overflow-y: auto;
	}

	.fc-card.no-anim .fc-face {
		transition: none;
	}

	.fc-face--front {
		transform: rotateY(0deg);
		justify-content: center;
		align-items: center;
		text-align: center;
	}

	.fc-face--back {
		transform: rotateY(-180deg);
		background-color: #ebecd9;
		border-color: var(--cp-gold, #a3781e);
		outline-color: rgba(163, 120, 30, 0.55);
	}

	.fc-card.flipped .fc-face--front {
		transform: rotateY(180deg);
	}

	.fc-card.flipped .fc-face--back {
		transform: rotateY(0deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.fc-face {
			transition: none;
		}
	}

	/* Sash-style label, like a ribbon across a pamphlet */
	.fc-face-label {
		align-self: center;
		background: var(--cp-green, #1e4d38);
		color: var(--cp-cream, #f6f0dd);
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		padding: 0.3rem 1.5rem;
		clip-path: polygon(
			0.6rem 0,
			calc(100% - 0.6rem) 0,
			100% 50%,
			calc(100% - 0.6rem) 100%,
			0.6rem 100%,
			0 50%
		);
	}

	.fc-face-label--gold {
		background: var(--cp-gold, #a3781e);
		color: #fff;
	}

	.fc-front-text {
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 4vw, 2rem);
		font-weight: 700;
		line-height: 1.2;
		color: var(--cp-green-dark, #143427);
	}

	.fc-flip-hint {
		margin-top: auto;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.85rem;
		color: var(--cp-gold, #a3781e);
		letter-spacing: 0.08em;
	}

	.fc-back-text {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.55;
	}

	.fc-hook {
		margin-top: auto;
		padding-top: 0.75rem;
		border-top: 1px solid rgba(163, 120, 30, 0.5);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--cp-seal-red, #9e2b25);
		font-weight: 600;
	}

	.fc-hook::before {
		content: '☛ ';
		color: var(--cp-gold, #a3781e);
	}

	.fc-judge {
		margin-top: 1.25rem;
		text-align: center;
	}

	.fc-judge-prompt {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--cp-green-dark, #143427);
		margin: 0 0 0.6rem;
	}

	.fc-judge-buttons {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.fc-judge-note {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		color: var(--cp-ink, #1c2b23);
		opacity: 0.65;
		margin: 0.6rem 0 0;
	}

	.fc-controls {
		margin-top: 1.5rem;
		text-align: center;
	}

	.fc-shuffle {
		background: none;
		border: none;
		padding: 0.25rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--cp-gold, #a3781e);
		cursor: pointer;
		text-decoration: underline;
	}

	.fc-shuffle:hover {
		color: var(--cp-seal-red, #9e2b25);
	}

	/* End-of-deck panel styled as an engraved certificate (frame from .cp-frame) */
	.fc-summary {
		padding: 2.25rem 1.5rem 2rem;
		text-align: center;
	}

	.fc-summary-seal {
		font-size: 1.5rem;
		margin-bottom: 0.85rem;
	}

	.fc-summary-kicker {
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		color: var(--cp-gold, #a3781e);
		margin: 0 0 0.5rem;
	}

	.fc-summary-headline {
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--cp-green-dark, #143427);
		margin: 0 0 0.5rem;
	}

	.fc-summary-detail {
		font-family: var(--font-sans);
		color: var(--cp-ink, #1c2b23);
		opacity: 0.75;
		font-size: 0.95rem;
		margin: 0 0 1.25rem;
	}

	.fc-summary-buttons {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.fc-noscript {
		font-family: var(--font-sans);
		border: 2px solid var(--cp-green, #1e4d38);
		padding: 1rem;
		background: var(--cp-cream, #f6f0dd);
	}

	@media (max-width: 540px) {
		.fc-card {
			min-height: 24rem;
		}
	}
</style>
