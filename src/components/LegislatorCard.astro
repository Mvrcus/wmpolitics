---
import type { CollectionEntry } from "astro:content";
import { formatTermRange, isCurrentLegislator } from "../lib/legislators";
import { partyInfo } from "../lib/party";

interface Props {
	legislator: CollectionEntry<"legislators">;
}

const { legislator } = Astro.props;
const { name, slug, office, district, party, summary, proximityRank, photo, termStart, termEnd } =
	legislator.data;
const isOfficialPortrait = legislator.data.photoIsOfficial === true;
const isPast = !isCurrentLegislator(legislator);
const termDisplay = formatTermRange(termStart, termEnd);

const officeLabels: Record<string, string> = {
	"us-house": "U.S. House",
	"us-senate": "U.S. Senate",
	governor: "Governor",
	"state-house": "State House",
	"state-senate": "State Senate",
	local: "Local",
};

const partyIdentity = partyInfo(party);
const partyBadgeClass =
	partyIdentity?.key === 'democrat'
		? 'badge-party-d'
		: partyIdentity?.key === 'republican'
			? 'badge-party-r'
			: '';
---

<article
	class:list={['legislator-card', partyIdentity && `legislator-card--${partyIdentity.key}`]}
>
	<a href={`/legislators/${slug}/`} class="legislator-card-link">
		{photo && (
			<figure class="legislator-card-photo">
				<img
					src={photo}
					alt={
						isOfficialPortrait
							? `Official portrait of ${name}`
							: `Representative imagery for ${name}`
					}
					width={120}
					height={150}
					loading="lazy"
					decoding="async"
				/>
				{partyIdentity && (
					<span
						class:list={['party-stamp', `party-stamp--${partyIdentity.key}`]}
						aria-hidden="true"
					>
						{partyIdentity.abbrev}
					</span>
				)}
			</figure>
		)}
		<div class="card-meta">
			<span class="category-label">{officeLabels[office] ?? office}</span>
			{party && <span class:list={["category-label", partyBadgeClass]}>{party}</span>}
			{isPast && <span class="category-label">Past</span>}
			{proximityRank === 1 && <span class="category-label badge-holland">Holland area</span>}
		</div>
		<h3>{name}</h3>
		<p class="district">
			{district}
			{termDisplay && <span class="term-range"> · {termDisplay}</span>}
		</p>
		<p class="summary">{summary}</p>
		<span class="read-more">View profile</span>
	</a>
</article>

<style>
	.legislator-card {
		border-top: 2px solid var(--color-black);
		padding-top: 1.25rem;
		height: 100%;
	}

	.legislator-card--republican {
		border-top-color: var(--party-republican);
	}

	.legislator-card--democrat {
		border-top-color: var(--party-democrat);
	}

	.legislator-card--nonpartisan,
	.legislator-card--other {
		border-top-color: var(--party-nonpartisan);
	}

	.legislator-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.legislator-card-photo {
		position: relative;
		margin: 0 0 1rem;
		aspect-ratio: 4 / 5;
		max-width: 7.5rem;
		overflow: hidden;
		border: 1px solid var(--color-border);
	}

	.legislator-card-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.legislator-card-link:hover h3 {
		color: var(--color-accent);
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.legislator-card h3 {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		margin-bottom: 0.35rem;
		transition: color 0.15s;
	}

	.district {
		font-size: 0.8125rem;
		color: var(--color-muted);
		margin: 0 0 0.75rem;
	}

	.summary {
		font-size: 0.9375rem;
		color: var(--color-muted);
		line-height: 1.55;
		flex-grow: 1;
		margin: 0 0 1rem;
	}

	.read-more {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--color-black);
	}

	.legislator-card-link:hover .read-more {
		color: var(--color-accent);
	}

	/* Compact two-line rows on phones — the whole card already links, so the
	   summary paragraph and read-more cue earn their keep on desktop only */
	@media (max-width: 640px) {
		.legislator-card {
			padding-top: 0.85rem;
		}

		.legislator-card-link {
			display: grid;
			grid-template-columns: 3.4rem minmax(0, 1fr);
			gap: 0.3rem 0.85rem;
			align-items: start;
		}

		.legislator-card-photo {
			grid-row: 1 / span 3;
			margin: 0;
			width: 3.4rem;
			max-width: none;
		}

		.legislator-card-photo :global(.party-stamp) {
			display: none;
		}

		.card-meta {
			gap: 0.5rem;
			margin-bottom: 0;
		}

		.legislator-card h3 {
			font-size: 1.05rem;
			margin-bottom: 0.1rem;
		}

		.district {
			margin-bottom: 0;
			font-size: 0.78rem;
		}

		.summary,
		.read-more {
			display: none;
		}
	}
</style>
