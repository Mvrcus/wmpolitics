---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { filterLegislatorsByStatus, sortLegislators } from '../lib/legislators';
import { partyInfo } from '../lib/party';
import { resolveEditorialScores } from '../lib/scores';

type Entry = CollectionEntry<'legislators'>;

const all = sortLegislators(
	filterLegislatorsByStatus(await getCollection('legislators'), 'current'),
).filter((l) => l.data.servesHolland);

const isCity = (l: Entry) => l.data.office === 'local' && l.data.seatSlug.startsWith('holland-');

const RUNGS: Array<{
	step: number;
	title: string;
	place: string;
	closeness: number;
	reach: string;
	decides: string[];
	holders: Entry[];
}> = [
	{
		step: 1,
		title: 'Your city',
		place: 'Holland City Hall',
		closeness: 5,
		reach: 'A phone call away — answers to a few thousand voters.',
		decides: ['Streets & snow plows', 'Water & sewer', 'Police & fire', 'Zoning & housing'],
		holders: all.filter(isCity),
	},
	{
		step: 2,
		title: 'Your county',
		place: 'Ottawa County',
		closeness: 4,
		reach: 'Public meetings you can attend — and speak at.',
		decides: ['Sheriff & jail', 'Health department', 'County parks', 'Running your elections'],
		holders: all.filter((l) => l.data.office === 'local' && !isCity(l)),
	},
	{
		step: 3,
		title: 'Your state legislators',
		place: 'Lansing',
		closeness: 3,
		reach: 'District offices take your calls; town halls vary.',
		decides: ['School funding', 'Road money', 'State laws that override cities'],
		holders: all.filter((l) => l.data.office === 'state-house' || l.data.office === 'state-senate'),
	},
	{
		step: 4,
		title: 'The Governor',
		place: 'Lansing — statewide',
		closeness: 2,
		reach: 'One office for 10 million people.',
		decides: ['Signs or vetoes every state law', 'Runs state agencies', 'Shapes the state budget'],
		holders: all.filter((l) => l.data.office === 'governor'),
	},
	{
		step: 5,
		title: 'Washington',
		place: 'U.S. House & Senate',
		closeness: 1,
		reach: 'Your representative and two senators — furthest from your kitchen table.',
		decides: ['Federal budget', 'Great Lakes funding', 'Social Security & Medicare law'],
		holders: all.filter((l) => l.data.office === 'us-house' || l.data.office === 'us-senate'),
	},
];

function serviceSignal(entry: Entry): { cls: string; label: string } | null {
	const scores = resolveEditorialScores(entry);
	if (!scores) return null;
	if (scores.overall >= 60) return { cls: 'good', label: `Serving well · ${scores.overall}/100` };
	if (scores.overall >= 40) return { cls: 'mixed', label: `Mixed · ${scores.overall}/100` };
	return { cls: 'poor', label: `Falling short · ${scores.overall}/100` };
}
---

<section class="power-ladder" id="power-ladder" aria-labelledby="power-ladder-heading">
	<span class="cc-watermark cc-watermark--dem" aria-hidden="true"></span>
	<span class="cc-watermark cc-watermark--rep" aria-hidden="true"></span>

	<header class="ladder-head">
		<h2 id="power-ladder-heading" class="ladder-title">Where does your power actually live?</h2>
		<p class="ladder-lead">
			Start at your own street — where one voice matters most — and climb toward Washington.
			Open a rung to see who holds it and what they decide for you.
		</p>
	</header>

	<ol class="ladder">
		{
			RUNGS.filter((rung) => rung.holders.length > 0).map((rung) => {
				const faces = rung.holders.filter((h) => h.data.photo).slice(0, 3);
				const extra = rung.holders.length - faces.length;
				const unscored = rung.holders.filter((h) => !serviceSignal(h)).length;
				return (
					<li class="rung">
						<details class="rung-card" open={rung.step === 1}>
							<summary class="rung-summary">
								<span class="rung-step" aria-hidden="true">{rung.step}</span>
								<span class="rung-sum-text">
									<h3 class="rung-title">{rung.title}</h3>
									<span class="rung-sum-meta">
										{rung.place} · {rung.holders.length}{' '}
										{rung.holders.length === 1 ? 'official' : 'officials'}
									</span>
								</span>
								<span class="rung-faces" aria-hidden="true">
									{faces.map((h) => (
										<span class="rung-face">
											<img src={h.data.photo} alt="" width={26} height={26} loading="lazy" decoding="async" />
										</span>
									))}
									{extra > 0 && <span class="rung-face-more">+{extra}</span>}
								</span>
								<span class="rung-caret" aria-hidden="true">▾</span>
							</summary>
							<div class="rung-body">
								<div class="rung-meta-row">
									<p class="rung-reach">{rung.reach}</p>
									<div class="rung-closeness" title={`Closeness to your daily life: ${rung.closeness} of 5`}>
										<span class="rung-closeness-label">Close to home</span>
										<span class="closeness-meter" role="img" aria-label={`Closeness to your daily life: ${rung.closeness} out of 5`}>
											{[1, 2, 3, 4, 5].map((i) => (
												<i class:list={['closeness-seg', i <= rung.closeness && 'closeness-seg--on']} />
											))}
										</span>
									</div>
								</div>
								<ul class="rung-decides">
									{rung.decides.map((item) => (
										<li>{item}</li>
									))}
								</ul>
								<ul class="rung-holders">
									{rung.holders.map((holder) => {
										const signal = serviceSignal(holder);
										const identity = partyInfo(holder.data.party);
										return (
											<li>
												<a class="holder-row" href={`/legislators/${holder.data.slug}/`}>
													{holder.data.photo && (
														<span class="holder-photo">
															<img
																src={holder.data.photo}
																alt=""
																width={56}
																height={70}
																loading="lazy"
																decoding="async"
															/>
															{identity && (
																<span
																	class:list={['party-stamp', 'party-stamp--mini', `party-stamp--${identity.key}`]}
																	aria-hidden="true"
																>
																	{identity.abbrev}
																</span>
															)}
														</span>
													)}
													<span class="holder-text">
														<strong>{holder.data.name}</strong>
														<span class="holder-district">{holder.data.district}</span>
														{signal && (
															<span class:list={['signal-chip', `signal-chip--${signal.cls}`]}>
																<span class:list={['signal-dot', `signal-dot--${signal.cls}`]} aria-hidden="true" />
																{signal.label}
															</span>
														)}
													</span>
												</a>
											</li>
										);
									})}
								</ul>
								{unscored > 0 && (
									<p class="rung-unscored">
										{unscored} of {rung.holders.length} not yet scored —{' '}
										<a href="/coverage/">how scoring works</a>
									</p>
								)}
							</div>
						</details>
					</li>
				);
			})
		}
	</ol>

	<p class="ladder-foot">
		Scores are editorial, given only after enough sourced reporting — see{' '}
		<a href="/coverage/">how we score</a> and cast your own on any profile.
	</p>
</section>
