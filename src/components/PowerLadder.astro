---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { filterLegislatorsByStatus, sortLegislators } from '../lib/legislators';
import { partyInfo } from '../lib/party';
import { resolveEditorialScores } from '../lib/scores';
import { LEVELS } from '../data/election-seats';
import type { Seat } from '../data/election-seats';

type Entry = CollectionEntry<'legislators'>;

const all = sortLegislators(
	filterLegislatorsByStatus(await getCollection('legislators'), 'current'),
).filter((l) => l.data.servesHolland);

const isCity = (l: Entry) => l.data.office === 'local' && l.data.seatSlug.startsWith('holland-');

// Join each officeholder to their seat's election data (term length, next
// election, declared candidates) via the shared seatSlug.
const seatBySlug = new Map<string, Seat>(
	LEVELS.flatMap((level) => level.seats)
		.filter((seat) => seat.seatSlug)
		.map((seat) => [seat.seatSlug!, seat]),
);

function seatMeta(entry: Entry): string | null {
	const seat = seatBySlug.get(entry.data.seatSlug);
	const parts: string[] = [];
	if (entry.data.termStart) parts.push(`Serving since ${entry.data.termStart}`);
	if (seat) {
		if (seat.term === 'Appointed') {
			parts.push('Appointed — no election');
		} else {
			parts.push(`${seat.term.replace(' years', '-year')} term`);
			if (entry.data.termEnd) parts.push(`term ends ${entry.data.termEnd}`);
			parts.push(`on the ballot ${seat.nextElection}`);
		}
	} else if (entry.data.termEnd) {
		parts.push(`term ends ${entry.data.termEnd}`);
	}
	return parts.length ? parts.join(' · ') : null;
}

const PARTY_LABEL: Record<string, string> = { R: 'Republican', D: 'Democrat', I: 'Independent' };

const RUNGS: Array<{
	step: number;
	title: string;
	place: string;
	closeness: number;
	reach: string;
	decides: string[];
	holders: Entry[];
	/** Anchor on /learn/elections/ with this rung's full seat table. */
	levelId: string;
}> = [
	{
		step: 1,
		title: 'Your city',
		place: 'Holland City Hall',
		closeness: 5,
		reach: 'A phone call away — answers to a few thousand voters.',
		decides: ['Streets & snow plows', 'Water & sewer', 'Police & fire', 'Zoning & housing'],
		holders: all.filter(isCity),
		levelId: 'city',
	},
	{
		step: 2,
		title: 'Your county',
		place: 'Ottawa County — board & elected officers',
		closeness: 4,
		reach: 'Public meetings you can attend — and speak at.',
		decides: ['Sheriff & jail', 'Health department', 'County parks', 'Running your elections'],
		holders: all.filter((l) => l.data.office === 'local' && !isCity(l)),
		levelId: 'county',
	},
	{
		step: 3,
		title: 'Your state legislators',
		place: 'Lansing',
		closeness: 3,
		reach: 'District offices take your calls; town halls vary.',
		decides: ['School funding', 'Road money', 'State laws that override cities'],
		holders: all.filter((l) => l.data.office === 'state-house' || l.data.office === 'state-senate'),
		levelId: 'state',
	},
	{
		step: 4,
		title: 'The Governor',
		place: 'Lansing — statewide',
		closeness: 2,
		reach: 'One office for 10 million people.',
		decides: ['Signs or vetoes every state law', 'Runs state agencies', 'Shapes the state budget'],
		holders: all.filter((l) => l.data.office === 'governor'),
		levelId: 'state',
	},
	{
		step: 5,
		title: 'Washington',
		place: 'U.S. House & Senate',
		closeness: 1,
		reach: 'Your representative and two senators — furthest from your kitchen table.',
		decides: ['Federal budget', 'Great Lakes funding', 'Social Security & Medicare law'],
		holders: all.filter((l) => l.data.office === 'us-house' || l.data.office === 'us-senate'),
		levelId: 'federal',
	},
];

function serviceSignal(entry: Entry): { cls: string; label: string } {
	const scores = resolveEditorialScores(entry);
	if (!scores) return { cls: 'unscored', label: 'Not yet scored' };
	if (scores.overall >= 60) return { cls: 'good', label: `Serving well · ${scores.overall}/100` };
	if (scores.overall >= 40) return { cls: 'mixed', label: `Mixed · ${scores.overall}/100` };
	return { cls: 'poor', label: `Falling short · ${scores.overall}/100` };
}
---

<section class="power-ladder" id="power-ladder" aria-labelledby="power-ladder-heading">
	<span class="cc-watermark cc-watermark--dem" aria-hidden="true"></span>
	<span class="cc-watermark cc-watermark--rep" aria-hidden="true"></span>

	<header class="ladder-head">
		<h2 id="power-ladder-heading" class="ladder-title">Where does your power actually live?</h2>
		<p class="ladder-lead">
			Start at your own street — that's where one voice matters most — and climb rung by rung to
			Lansing and Washington. At every step: who holds the seat, what they decide for you, and
			whether the record says they're serving this area.
		</p>
		<p class="ladder-legend" aria-hidden="true">
			<span class="signal-dot signal-dot--good"></span> Serving well
			<span class="signal-dot signal-dot--mixed"></span> Mixed
			<span class="signal-dot signal-dot--poor"></span> Falling short
			<span class="signal-dot signal-dot--unscored"></span> Not yet scored
		</p>
	</header>

	<ol class="ladder">
		{
			RUNGS.filter((rung) => rung.holders.length > 0).map((rung) => (
				<li class="rung">
					<div class="rung-rail" aria-hidden="true">
						<span class="rung-step">{rung.step}</span>
					</div>
					<div class="rung-body">
						<div class="rung-head">
							<div>
								<h2 class="rung-title">{rung.title}</h2>
								<p class="rung-place">{rung.place}</p>
							</div>
							<div class="rung-closeness" title={`Closeness to your daily life: ${rung.closeness} of 5`}>
								<span class="rung-closeness-label">Close to home</span>
								<span class="closeness-meter" role="img" aria-label={`Closeness to your daily life: ${rung.closeness} out of 5`}>
									{[1, 2, 3, 4, 5].map((i) => (
										<i class:list={['closeness-seg', i <= rung.closeness && 'closeness-seg--on']} />
									))}
								</span>
							</div>
						</div>
						<p class="rung-reach">{rung.reach}</p>
						<ul class="rung-decides">
							{rung.decides.map((item) => (
								<li>{item}</li>
							))}
						</ul>
						<ul class="rung-holders">
							{rung.holders.map((holder) => {
								const signal = serviceSignal(holder);
								const identity = partyInfo(holder.data.party);
								const seat = seatBySlug.get(holder.data.seatSlug);
								const meta = seatMeta(holder);
								return (
									<li>
										<a class="holder-row" href={`/legislators/${holder.data.slug}/`}>
											{holder.data.photo && (
												<span class="holder-photo">
													<img
														src={holder.data.photo}
														alt=""
														width={56}
														height={70}
														loading="lazy"
														decoding="async"
													/>
													{identity && (
														<span
															class:list={['party-stamp', 'party-stamp--mini', `party-stamp--${identity.key}`]}
															aria-hidden="true"
														>
															{identity.abbrev}
														</span>
													)}
												</span>
											)}
											<span class="holder-text">
												<strong>{holder.data.name}</strong>
												<span class="holder-district">{holder.data.district}</span>
												{meta && <span class="holder-term">{meta}</span>}
											</span>
											<span class:list={['holder-signal', `holder-signal--${signal.cls}`]}>
												<span class:list={['signal-dot', `signal-dot--${signal.cls}`]} aria-hidden="true" />
												{signal.label}
											</span>
										</a>
										{seat?.candidates && (
											<div class="holder-race">
												<span class="holder-race-label">
													Running in {seat.nextElection}
													{seat.raceNote && <em> — {seat.raceNote}</em>}
												</span>
												<ul class="race-candidates">
													{seat.candidates.map((cand) => (
														<li
															class:list={[
																'race-cand',
																cand.party && `race-cand--${cand.party.toLowerCase()}`,
																cand.incumbent && 'race-cand--incumbent',
															]}
															title={cand.note}
														>
															{cand.name}
															{cand.party && (
																<span class="race-cand-party" aria-label={PARTY_LABEL[cand.party]}>
																	{cand.party}
																</span>
															)}
														</li>
													))}
												</ul>
											</div>
										)}
									</li>
								);
							})}
						</ul>
						<p class="rung-more">
							<a href={`/learn/elections/#${rung.levelId}`}>
								Full cheat sheet: terms, term limits & who runs when →
							</a>
						</p>
					</div>
				</li>
			))
		}
	</ol>

	<p class="ladder-foot">
		Scores are editorial, given only after enough sourced reporting — see{' '}
		<a href="/coverage/">how we score</a> and cast your own on any profile.
	</p>
</section>
