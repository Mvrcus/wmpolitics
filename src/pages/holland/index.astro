---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LegislatorCard from '../../components/LegislatorCard.astro';
import { SITE_TITLE } from '../../consts';
import { getHollandLegislators } from '../../lib/content';
import { groupLegislatorsByOffice } from '../../lib/legislators';

const grouped = groupLegislatorsByOffice(await getHollandLegislators());

const title = `Holland & Ottawa County | ${SITE_TITLE}`;
const description =
	'Who represents Holland, Michigan—from city commissioner to Congress—and how to understand their records.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<div class="holland-header-row">
					<div class="holland-header-text">
						<span class="category-label badge-holland">Local reporting</span>
						<h1>Holland & Ottawa County</h1>
						<p class="hero-lead">
							Holland sits in Ottawa County with overlapping federal, state, and local districts.
							Use this page to see who represents you and open balanced profiles.
						</p>
					</div>
					<figure class="holland-hero-thumb">
						<a
							href="/images/holland-lighthouse.jpg"
							target="_blank"
							rel="noopener noreferrer"
							title="Holland Harbor Light (Big Red) — click for the full photo"
						>
							<img
								src="/images/holland-lighthouse.jpg"
								alt="Holland Harbor Light (Big Red) on Lake Michigan — click to view full size"
								width={152}
								height={193}
								loading="eager"
								decoding="async"
							/>
						</a>
						<figcaption>
							“Big Red” — <a href="https://commons.wikimedia.org/wiki/File:Holland_Harbor_Light_(Big_Red)_-_Holland,_Michigan.jpg" target="_blank" rel="noopener noreferrer">A. Parodi, CC BY-SA 3.0</a>
						</figcaption>
					</figure>
				</div>
			</header>

			<section class="section">
				<div class="section-header">
					<h2>Who represents Holland</h2>
					<a href="/#power-ladder">See the power ladder</a>
				</div>
				{
					grouped.map((group) => (
						<div class="holland-office-group">
							<h3 class="who-represents-office">{group.label}</h3>
							<ul class="card-grid">
								{group.legislators.map((leg) => (
									<li>
										<LegislatorCard legislator={leg} />
									</li>
								))}
							</ul>
						</div>
					))
				}
				<p class="who-represents-verify">
					Wondering when each of these seats is next on your ballot? See{' '}
					<a href="/learn/elections/">who runs when</a> — term lengths, election years, and
					term-limit rules for every level.
				</p>
				<p class="who-represents-verify">
					District lines change after redistricting. Verify your address on{' '}
					<a href="https://www.michigan.gov/vote" target="_blank" rel="noopener noreferrer">
						Michigan Voter Information
					</a>
					before contacting an office.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
