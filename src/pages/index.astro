---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PowerLadder from '../components/PowerLadder.astro';
import VotePicture from '../components/VotePicture.astro';
import WhatChanged from '../components/WhatChanged.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../consts';
import { getFeaturedArticles, getLatestArticles } from '../lib/content';

const featuredCandidates = await getFeaturedArticles();
const allLatest = await getLatestArticles();
const featuredArticle = featuredCandidates[0] ?? allLatest[0];
const latestArticles = allLatest
	.filter((a) => a.id !== featuredArticle?.id)
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<StructuredData
			data={{
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				description: SITE_DESCRIPTION,
				url: SITE_URL,
				potentialAction: {
					'@type': 'SearchAction',
					target: `${SITE_URL}/legislators/`,
					'query-input': 'required name=search_term_string',
				},
			}}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="home-intro" aria-label="What this site does">
				<span class="cc-watermark cc-watermark--dem home-intro-watermark" aria-hidden="true"></span>
				<span class="cc-watermark cc-watermark--rep home-intro-watermark" aria-hidden="true"></span>
				<div class="home-intro-inner">
				<h1 class="home-intro-title">Know who actually works for you.</h1>
				<p class="home-intro-lead">
					Plain-English records of every officeholder serving Holland and Ottawa County.
					Every claim sourced. No party spin.
				</p>
				<ul class="home-intro-points">
					<li>Who represents you</li>
					<li>Their real record</li>
					<li>Your next election</li>
				</ul>
				<a class="btn btn-primary home-intro-cta" href="#power-ladder">Start at your own street</a>
				</div>
			</section>

			<PowerLadder />

			<VotePicture />

			<section class="section">
				<WhatChanged />
			</section>

			{featuredArticle && (
				<section class="featured-story" aria-label="Featured story">
					<div class="featured-main">
						{featuredArticle.data.category && (
							<span class="category-label">{featuredArticle.data.category}</span>
						)}
						<h2>
							<a href={`/updates/${featuredArticle.id}/`}>{featuredArticle.data.title}</a>
						</h2>
						<p class="featured-dek">{featuredArticle.data.description}</p>
						<p class="featured-meta">
							<FormattedDate date={featuredArticle.data.pubDate} />
						</p>
					</div>
				</section>
			)}

			<section class="newsletter-block" id="newsletter">
				<NewsletterSignup />
			</section>

			<section class="section">
				<div class="section-header">
					<h2>Latest</h2>
					<a href="/updates/">All updates</a>
				</div>
				<ul class="article-grid article-grid--three">
					{latestArticles.map((article) => (
						<li>
							<ArticleCard article={article} />
						</li>
					))}
				</ul>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>Legislators</h2>
					<a href="/legislators/">View all</a>
				</div>
				<p class="hero-lead" style="margin-bottom: 2rem;">
					Balanced profiles: what supporters highlight and what critics raise — with sources
					you can verify, and a community vote on every profile.
				</p>
				<div class="start-links">
					<a href="/legislators/" class="btn btn-primary">Browse all profiles</a>
					<a href="/coverage/" class="text-link">Coverage dashboard</a>
					<a href="/about/" class="text-link">Our standards</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
