---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const title = `Start Here | ${SITE_TITLE}`;
const description =
	'New to politics? A friendly, jargon-free guide to what legislators are, what they actually do, and how their choices land on your street.';

const JOBS = [
	{
		title: 'Write and vote on laws',
		text: 'The headline job. They propose rules, argue about them, amend them, and vote yes or no — on everything from speed limits to school curricula.',
	},
	{
		title: 'Decide where the money goes',
		text: 'Every year they pass budgets. Roads or tax cuts? More school aid or more police funding? Budgets are where promises become real.',
	},
	{
		title: 'Keep watch',
		text: 'Legislators question agencies, hold hearings, and investigate when something goes wrong — from water crises to wasted money. It’s called oversight.',
	},
	{
		title: 'Help you, personally',
		text: 'Stuck passport? Lost VA benefits? Unemployment claim in limbo? Their staff untangle problems with government agencies for constituents every day. It’s free — it’s literally their job.',
	},
];

const CHAINS = [
	{
		label: 'Your commute',
		steps: [
			'Lansing votes on how road money is split up',
			'Your county road commission gets its budget',
			'Your street gets repaved — or patched for the fifth time',
		],
	},
	{
		label: 'Your kid’s classroom',
		steps: [
			'The state budget sets funding per student',
			'Your school district plans around that number',
			'Class sizes, bus routes, and which programs survive',
		],
	},
	{
		label: 'Your beach day',
		steps: [
			'Congress funds (or cuts) Great Lakes restoration',
			'Grants flow to local water projects',
			'Whether the water at Holland State Park is safe to swim',
		],
	},
];

const LAW_STEPS = [
	{ step: 'An idea', text: 'Anyone can have it — a legislator, a business, or a neighbor who’s had enough.' },
	{ step: 'A bill', text: 'A legislator writes it up and formally introduces it. Now it has a number you can track.' },
	{ step: 'Committee', text: 'A small group studies it, holds hearings, and decides if it moves on. Most bills die right here, quietly.' },
	{ step: 'Floor votes', text: 'The full House votes, then the full Senate (or vice versa). Both have to pass the same text.' },
	{ step: 'Signature', text: 'The governor (or president) signs it into law — or vetoes it, which the legislature can only override with a two-thirds vote.' },
	{ step: 'Real life', text: 'Agencies write the fine print and enforce it. This is when it starts showing up in your life.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<p class="learn-kicker">No experience required</p>
				<h1>New to politics? Start here.</h1>
				<p class="hero-lead">
					No lectures, no jargon, and no assumption you’ve been following along. Ten minutes here
					and the rest of this site — and honestly, the news — will make a lot more sense.
				</p>
			</header>

			<section class="section">
				<div class="prose">
					<h2>What is a legislator, actually?</h2>
					<p>
						A legislator is a person your community hires — by voting — to make its rules. That’s
						it. City council members, state representatives, state senators, and members of
						Congress are all legislators. They don’t run the police department or plow the snow;
						they write the rules and approve the money for the people who do.
					</p>
					<p>
						And here’s the part almost nobody realizes: <strong>you have a whole team of them
						right now.</strong> If you live in Holland, you’re represented by city council
						members, county commissioners, one state representative, one state senator, one U.S.
						representative, and two U.S. senators — every one of them with an office that is
						required to take your call.
					</p>
					<p>
						<a href="/legislators/">Meet yours here</a> — every profile shows what supporters
						highlight <em>and</em> what critics raise, so you can make up your own mind.
					</p>
				</div>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>So what do they do all day?</h2>
				</div>
				<p class="hero-lead learn-section-lead">Four jobs, really. Only the first one makes the news.</p>
				<div class="job-grid">
					{
						JOBS.map((job, i) => (
							<article class="job-card">
								<span class="job-num" aria-hidden="true">{i + 1}</span>
								<h3>{job.title}</h3>
								<p>{job.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>How a vote far away lands on your street</h2>
				</div>
				<p class="hero-lead learn-section-lead">
					“Politics doesn’t affect me” usually means the chain is just hard to see. Here are three
					of them, start to finish.
				</p>
				<div class="chain-grid">
					{
						CHAINS.map((chain) => (
							<article class="chain-card">
								<h3>{chain.label}</h3>
								<ol>
									{chain.steps.map((step) => (
										<li>{step}</li>
									))}
								</ol>
							</article>
						))
					}
				</div>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>How an idea becomes a law</h2>
				</div>
				<p class="hero-lead learn-section-lead">The 30-second version.</p>
				<ol class="law-steps">
					{
						LAW_STEPS.map((item, i) => (
							<li class="law-step">
								<span class="law-step-num" aria-hidden="true">{i + 1}</span>
								<div>
									<h3>{item.step}</h3>
									<p>{item.text}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="section">
				<div class="cheat-sheet-cta">
					<div>
						<p class="learn-kicker">The cheat sheet</p>
						<h2>So when do you actually get a say?</h2>
						<p>
							Every seat that represents Holland — who holds it, how long terms last, when it's
							next on your ballot, and the term-limit rules — in four quick tables.
						</p>
					</div>
					<a href="/learn/elections/" class="btn">See who runs when →</a>
				</div>
			</section>

			<section class="section">
				<div class="game-cta">
					<p class="learn-kicker">Quiz yourself</p>
					<h2>Think it stuck? Play the flashcards.</h2>
					<p>
						Three decks: <strong>the words</strong> you’ll see in headlines, <strong>history in a
						flash</strong> — laws that changed everyday life — and <strong>people who
						delivered</strong>, legislators (several from right here in West Michigan) remembered
						for actually representing their neighbors. Flip a card, be honest about whether you
						knew it, and the ones you miss come back around until they stick.
					</p>
					<a href="/learn/flashcards/" class="btn game-cta-btn">Play the flashcards →</a>
				</div>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>Do one thing today</h2>
				</div>
				<div class="prose">
					<ul>
						<li>
							<strong>Find your people.</strong> Browse <a href="/legislators/">the legislators
							who represent this area</a> and read one profile — both the supporter side and the
							critic side.
						</li>
						<li>
							<strong>Save one phone number.</strong> Pick the office closest to home and put
							their district office number in your phone. You’ll be glad it’s there the day you
							need it.
						</li>
						<li>
							<strong>Check the receipts.</strong> When someone tells you what a politician
							“always” does, look at the record — that’s what <a href="/coverage/">our coverage
							dashboard</a> is for.
						</li>
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.learn-kicker {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
		margin: 0 0 0.5rem;
	}

	.learn-section-lead {
		margin-bottom: 2rem;
	}

	.job-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem;
	}

	.job-card {
		position: relative;
		border: 2px solid var(--color-black);
		background: var(--color-white);
		padding: 1.25rem;
		box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
	}

	.job-num {
		font-family: var(--font-serif);
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1;
	}

	.job-card h3 {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		margin: 0.5rem 0 0.5rem;
	}

	.job-card p {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0;
	}

	.chain-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
	}

	.chain-card {
		border: 2px solid var(--color-black);
		background: var(--color-surface);
		padding: 1.25rem;
	}

	.chain-card h3 {
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 0.85rem;
		color: var(--color-accent);
	}

	.chain-card ol {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: chain;
	}

	.chain-card li {
		counter-increment: chain;
		position: relative;
		padding: 0 0 0.9rem 1.75rem;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.chain-card li::before {
		content: counter(chain);
		position: absolute;
		left: 0;
		top: 0.1em;
		width: 1.2rem;
		height: 1.2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-black);
		color: var(--color-white);
		font-size: 0.7rem;
		font-weight: 700;
	}

	.chain-card li:not(:last-child)::after {
		content: '';
		position: absolute;
		left: calc(0.6rem - 1px);
		top: 1.5rem;
		bottom: 0.15rem;
		width: 2px;
		background: var(--color-border);
	}

	.chain-card li:last-child {
		padding-bottom: 0;
		font-weight: 600;
	}

	.law-steps {
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 44rem;
	}

	.law-step {
		display: flex;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.law-step:first-child {
		border-top: 2px solid var(--color-black);
	}

	.law-step:last-child {
		border-bottom: 2px solid var(--color-black);
	}

	.law-step-num {
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px solid var(--color-black);
		font-family: var(--font-serif);
		font-weight: 700;
	}

	.law-step h3 {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		margin: 0 0 0.25rem;
	}

	.law-step p {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--color-muted);
		margin: 0;
	}

	.cheat-sheet-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		border: 2px solid var(--color-black);
		background: var(--color-surface);
		padding: 1.75rem clamp(1.25rem, 4vw, 2.5rem);
		box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
	}

	.cheat-sheet-cta h2 {
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 3vw, 1.7rem);
		margin: 0 0 0.5rem;
	}

	.cheat-sheet-cta p:last-child {
		font-family: var(--font-sans);
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 38rem;
		margin: 0;
	}

	.game-cta {
		border: 2px solid var(--color-black);
		background: var(--color-surface-dark, #111);
		color: var(--color-white);
		padding: 2.5rem clamp(1.25rem, 4vw, 3rem);
		box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.15);
	}

	.game-cta h2 {
		font-family: var(--font-serif);
		color: var(--color-white);
		font-size: clamp(1.5rem, 4vw, 2.1rem);
		margin: 0 0 0.75rem;
	}

	.game-cta p {
		font-family: var(--font-sans);
		font-size: 0.95rem;
		line-height: 1.6;
		max-width: 46rem;
		margin: 0 0 1.5rem;
		color: rgba(255, 255, 255, 0.85);
	}

	.game-cta strong {
		color: var(--color-white);
	}

	.game-cta-btn {
		font-size: 1rem;
		background: var(--color-accent);
		border-color: var(--color-accent);
	}

	.game-cta-btn:hover {
		background: var(--color-white);
		border-color: var(--color-white);
	}
</style>
